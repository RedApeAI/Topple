NODE_ENV=development
PORT=4000

# Neon/Postgres connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=ruNBzjVfGoaJ1vq8tyQ9EaORezR4lj07
# Fallback auth origin. Allowlisted FRONTEND_ORIGINS are resolved dynamically
# so OAuth can remain on the same host when using an HTTPS development tunnel.
BETTER_AUTH_URL=http://localhost:4000

# Exact, comma-separated origins. Wildcards are rejected.
FRONTEND_ORIGINS=http://localhost:3000,https://your-project.vercel.app

# Set true only when the frontend and API are on different sites. Production
# cookies then use Secure + SameSite=None; HTTPS is mandatory.
COOKIE_CROSS_SITE=false

# Optional. Each provider is enabled only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Shared secret the orchestrator presents on /api/v1/mail/outbound so it can
# send mail as a user. Must match OUTBOUND_WEBHOOK_SECRET in the orchestrator.
# Generate with: openssl rand -hex 32
OUTBOUND_WEBHOOK_SECRET=

# Server-only Zernio credentials. Never expose this key to apps/web.
ZERNIO_API_KEY=sk_replace_with_your_zernio_api_key
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=replace_with_a_random_webhook_secret
# Must be publicly reachable over HTTPS; localhost cannot receive Zernio events.
ZERNIO_WEBHOOK_PUBLIC_URL=https://api.example.com/api/v1/zernio/webhooks
# Must be allowed by your Zernio application. Defaults to the first
# FRONTEND_ORIGINS entry plus /dashboard/zernio/callback.
ZERNIO_CONNECT_REDIRECT_URL=http://localhost:3000/dashboard/zernio/callback
