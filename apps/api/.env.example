NODE_ENV=development
PORT=4000

# Neon/Postgres connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000

# Exact, comma-separated origins. Wildcards are rejected.
FRONTEND_ORIGINS=http://localhost:3000,https://your-project.vercel.app

# Set true only when the frontend and API are on different sites. Production
# cookies then use Secure + SameSite=None; HTTPS is mandatory.
COOKIE_CROSS_SITE=false

# Optional. Each provider is enabled only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
