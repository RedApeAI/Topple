NODE_ENV=development
PORT=4000

# Neon/Postgres connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Fallback auth origin. Allowlisted FRONTEND_ORIGINS are resolved dynamically
# so OAuth can remain on the same host when using an HTTPS development tunnel.
BETTER_AUTH_URL=http://localhost:4000

# Exact, comma-separated origins. Wildcards are rejected.
FRONTEND_ORIGINS=http://localhost:3000,https://your-project.vercel.app

# Set true only when the frontend and API are on different sites. Production
# cookies then use Secure + SameSite=None; HTTPS is mandatory.
COOKIE_CROSS_SITE=false

# Optional. Each provider is enabled only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Shared secret the orchestrator presents on /api/v1/mail/outbound so it can
# send mail as a user. Must match OUTBOUND_WEBHOOK_SECRET in the orchestrator.
# Generate with: openssl rand -hex 32
OUTBOUND_WEBHOOK_SECRET=

# Unipile unified messaging (LinkedIn, Sales Navigator/Recruiter, WhatsApp,
# Instagram, Telegram). Keep secrets out of wrangler.jsonc and source control.
# Application-scoped key created in the Unipile v2 dashboard. Legacy v1
# access tokens/DSN credentials do not work with api.unipile.com/v2.
UNIPILE_API_KEY=
UNIPILE_BASE_URL=https://api.unipile.com
UNIPILE_API_VERSION=v2
UNIPILE_WEBHOOK_SECRET=
UNIPILE_HOSTED_AUTH_DOMAIN=
# Optional fixed callback; otherwise the request origin plus the callback path
# is used and must be allowlisted by Unipile.
MESSAGING_CALLBACK_URL=
# Optional Cloudflare R2 binding is required for uploaded outbound files.
MESSAGING_MAX_ATTACHMENT_BYTES=15728640
MESSAGING_SSE_POLL_MS=2000
MESSAGING_SSE_MAX_SECONDS=25
# AI is opt-in. The provider URL accepts the internal JSON contract documented
# in docs/messaging-reference-mapping.md; inbound content is sent only when
# this flag and the provider URL are configured.
MESSAGING_AI_ENABLED=false
MESSAGING_AI_PROVIDER_URL=
MESSAGING_AI_API_KEY=
MESSAGING_AI_MODEL=messaging-default
