{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plucia-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "NODE_ENV": "production",
  },
}
