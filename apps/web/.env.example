# Leave empty in local development so frontend API requests use the
# frontend origin and Vite proxies them to the API process.
VITE_API_URL=
VITE_DEV_BACKEND_URL=http://127.0.0.1:4000
# Show the local-only development login on the Welcome page.
VITE_DEV_AUTH_BYPASS=false
# Comma-separated hostnames only (no https:// or paths) for local tunnels.
VITE_DEV_ALLOWED_HOSTS=
# The orchestrator process. Called directly rather than through the Vite proxy;
# its cors_origins must list this dashboard's origin.
VITE_ORCHESTRATOR_URL=http://localhost:8000
# Optional local fallback. In normal authenticated use, the active organization
# comes from the Better Auth session.
VITE_ORCHESTRATOR_TENANT_ID=
