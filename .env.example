NEXT_PUBLIC_WORKER_API_URL=http://localhost:8000
NEXT_PUBLIC_CALL_API_URL=http://localhost:8001
NEXT_PUBLIC_HEARTBEAT_API_URL=http://localhost:8002
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require
PORT=4000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_CROSS_SITE=false
# Force Secure cookie even behind a TLS-terminating proxy (default: prod / cross-site)
COOKIE_SECURE=false
# Session lifetime in seconds (default: 7 days)
SESSION_EXPIRES_IN=604800
# Auth rate limiting (sliding window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
# Password policy
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
# Per-account lockout after repeated failed sign-ins
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=900000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=



# The BFF, as the orchestrator sees it. Needed for the Gmail-backed recipient
# directory; authenticated with OUTBOUND_WEBHOOK_SECRET below.
BFF_BASE_URL=http://localhost:4000

# Where the orchestrator posts outbound messages. Point it at the BFF so an
# `email` dispatch becomes a Gmail send on behalf of the turn's user_id.
OUTBOUND_WEBHOOK_URL=http://localhost:4000/api/v1/mail/outbound
OUTBOUND_WEBHOOK_SECRET=

# vllm (self-hosted, multi-LoRA) | ollama (local dev) | bedrock (managed)
LLM_BACKEND=bedrock
# Only for vllm/ollama:
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_MODEL=
# Only for bedrock. The API key is a long-term key from the Bedrock console,
# not an AWS access key pair. MiniMax M2 has no geo/global inference profile,
# so the model id carries no regional prefix.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=minimax.minimax-m2
BEDROCK_API_KEY=
# A reasoning model thinks before it answers — 30s is too tight for Bedrock.
LLM_TIMEOUT_SECONDS=120
# Thinking tokens are billed as output; MiniMax M2 caps at 8K regardless.
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=
LLM_EXTRACT_TEMPERATURE=
LLM_GENERATE_TEMPERATURE=
MONGO_URL=
MONGO_DB=
QDRANT_URL=
QDRANT_API_KEY=
META_API_KEY=