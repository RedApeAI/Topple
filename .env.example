LLM_API_KEY=
LLM_BACKEND=
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_EXTRACT_TEMPERATURE=
LLM_GENERATE_TEMPERATURE=
MONGO_URL=
MONGO_DB=
